{
  "title": "Personal loans: operations",
  "uid": "personal-loans-ops",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "loans",
    "ledger"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Five-minute measure: loan system time (T0\u2192T1 + T2\u2192T3)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(loan_system_time_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loan_system_time_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(loan_system_time_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Decision time by outcome (p95)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(loan_decision_seconds_bucket[5m])))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Assessment stage duration (p95)",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(loan_assessment_stage_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Accept \u2192 disbursed (p50/p95/p99)",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(loan_accept_to_disbursed_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loan_accept_to_disbursed_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(loan_accept_to_disbursed_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Disbursements pending / oldest age",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "loan_disbursement_pending",
          "legendFormat": "pending"
        },
        {
          "expr": "loan_disbursement_oldest_pending_seconds",
          "legendFormat": "oldest age (s)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Payouts with unknown outcome / oldest age",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "loan_payout_unresolved",
          "legendFormat": "unresolved"
        },
        {
          "expr": "loan_payout_oldest_unresolved_seconds",
          "legendFormat": "oldest age (s)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Posting intents by kind and outcome",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (kind, outcome) (rate(loan_posting_intents_total[5m]))",
          "legendFormat": "{{kind}} {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Duplicates prevented (postings, API replays)",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(loan_duplicate_postings_prevented_total[5m]))",
          "legendFormat": "posting {{kind}}"
        },
        {
          "expr": "sum by (endpoint) (rate(loan_idempotent_replays_total[5m]))",
          "legendFormat": "replay {{endpoint}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Open reconciliation exceptions by kind",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (kind) (loan_recon_exceptions_open)",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Ledger invariant violations (must be 0)",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (kind) (ledger_invariant_violations)",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Ledger posting duration by journal type (p95)",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, journal_type) (rate(ledger_posting_duration_seconds_bucket[5m])))",
          "legendFormat": "{{journal_type}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Ledger rejections by reason",
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(ledger_postings_rejected_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Outbox age (ledger, lending)",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ledger_outbox_oldest_unpublished_seconds",
          "legendFormat": "ledger"
        },
        {
          "expr": "loan_outbox_oldest_unpublished_seconds",
          "legendFormat": "lending"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Consumer freshness: event age when handled (p95)",
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loan_event_age_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Database transaction retries (lock contention)",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (sqlstate) (rate(ledger_tx_retries_total[5m]))",
          "legendFormat": "ledger {{sqlstate}}"
        },
        {
          "expr": "sum by (sqlstate) (rate(loan_tx_retries_total[5m]))",
          "legendFormat": "lending {{sqlstate}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Provider calls by outcome",
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (provider, operation, outcome) (rate(loan_provider_call_seconds_count[5m]))",
          "legendFormat": "{{provider}} {{operation}} {{outcome}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Payout callbacks by outcome",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(loan_payout_callbacks_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Applications in assessment / manual review",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "loan_applications_in_assessment",
          "legendFormat": "assessing"
        },
        {
          "expr": "loan_applications_in_manual_review",
          "legendFormat": "manual review"
        }
      ]
    }
  ],
  "description": "Operational view of the personal-loan product. No panel uses a customer, loan or reference identifier as a label."
}
